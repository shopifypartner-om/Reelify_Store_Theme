
{% comment %}
  OrangeMantra - Shopify Apps Footer Showcase
  Compatible with Shopify OS 2.0 themes, including Horizon.
{% endcomment %}

<section
  id="om-apps-footer-{{ section.id }}"
  class="om-apps-footer"
  style="
    --om-accent: {{ section.settings.accent_color }};
    --om-heading: {{ section.settings.heading_color }};
    --om-text: {{ section.settings.text_color }};
    --om-section-bg: {{ section.settings.background_color }};
    --om-card-bg: {{ section.settings.card_color }};
  "
>
  <div class="om-apps-footer__inner">

    <div class="om-apps-footer__heading">
      {% if section.settings.eyebrow != blank %}
        <p class="om-apps-footer__eyebrow">
          {{ section.settings.eyebrow | escape }}
        </p>
      {% endif %}

      <h2>{{ section.settings.heading | escape }}</h2>

      {% if section.settings.description != blank %}
        <p class="om-apps-footer__description">
          {{ section.settings.description | escape }}
        </p>
      {% endif %}
    </div>

    <div class="om-apps-footer__carousel-wrap">
      {% if section.settings.show_arrows %}
        <button
          class="om-apps-footer__arrow om-apps-footer__arrow--prev"
          type="button"
          aria-label="Previous apps"
          data-om-prev
        >
          &#8249;
        </button>
      {% endif %}

      <div
        class="om-apps-footer__track"
        data-om-track
        role="list"
        aria-label="Other Shopify apps"
      >
        {% for block in section.blocks %}
          <article
  class="om-apps-footer__card"
  role="listitem"
  data-app-name="{{ block.settings.app_name | escape }}"
  {{ block.shopify_attributes }}
>
            <a
              class="om-apps-footer__card-link"
              href="{{ block.settings.app_url | default: '#' | escape }}"
              {% if block.settings.app_url != blank %}
                target="_blank"
                rel="noopener noreferrer"
              {% endif %}
              aria-label="Explore {{ block.settings.app_name | escape }}"
            >
              <div class="om-apps-footer__card-top">
                <div class="om-apps-footer__icon">
                  {% if block.settings.app_icon != blank %}
                    {{
                      block.settings.app_icon
                      | image_url: width: 144
                      | image_tag:
                        loading: 'lazy',
                        widths: '72, 96, 144',
                        alt: block.settings.app_name
                    }}
                  {% else %}
                    <span class="om-apps-footer__icon-placeholder">
                      {{ block.settings.app_name | slice: 0 | upcase }}
                    </span>
                  {% endif %}
                </div>

                <span
                  class="om-apps-footer__card-arrow"
                  aria-hidden="true"
                >
                  &#8599;
                </span>
              </div>

              <h3>{{ block.settings.app_name | escape }}</h3>

              {% if block.settings.app_description != blank %}
                <p>
                  {{ block.settings.app_description | escape }}
                </p>
              {% endif %}

              <span class="om-apps-footer__learn">
                Explore app <span aria-hidden="true">→</span>
              </span>
            </a>
          </article>
        {% endfor %}
      </div>

      {% if section.settings.show_arrows %}
        <button
          class="om-apps-footer__arrow om-apps-footer__arrow--next"
          type="button"
          aria-label="Next apps"
          data-om-next
        >
          &#8250;
        </button>
      {% endif %}
    </div>

    {% if section.settings.show_all_button %}
      <div class="om-apps-footer__cta">
        <a
          href="{{ section.settings.all_apps_url | default: 'https://apps.shopify.com/partners/orangemantra5' | escape }}"
          class="om-apps-footer__button"
          target="_blank"
          rel="noopener noreferrer"
        >
          {{ section.settings.all_apps_label | escape }}
          <span aria-hidden="true">→</span>
        </a>
      </div>
    {% endif %}

  </div>

  {% if section.settings.show_brand_strip %}
    <div class="om-apps-footer__brand-strip">
      <div class="om-apps-footer__brand-inner">

        <div class="om-apps-footer__brand">
          <a
            href="{{ section.settings.brand_url | default: 'https://www.orangemantra.com/' | escape }}"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="OrangeMantra website"
          >
            {% if section.settings.brand_logo != blank %}
              {{
                section.settings.brand_logo
                | image_url: width: 440
                | image_tag:
                  loading: 'lazy',
                  widths: '180, 280, 440',
                  alt: 'OrangeMantra'
              }}
            {% else %}
              <span class="om-apps-footer__brand-name">
                <span>orange</span>mantra
              </span>
            {% endif %}
          </a>

          <p>{{ section.settings.brand_description | escape }}</p>

          {% if section.settings.contact_email != blank %}
            <a
              class="om-apps-footer__contact"
              href="mailto:{{ section.settings.contact_email | escape }}"
            >
              {{ section.settings.contact_email | escape }}
            </a>
          {% endif %}
        </div>

        <div class="om-apps-footer__brand-links">
          <h3>Explore</h3>
          <a href="{{ section.settings.all_apps_url | default: 'https://apps.shopify.com/partners/orangemantra' | escape }}" target="_blank" rel="noopener noreferrer">
            Shopify Apps
          </a>
          <a href="{{ section.settings.brand_url | default: 'https://www.orangemantra.com/' | escape }}" target="_blank" rel="noopener noreferrer">
            Our Website
          </a>
          {% if section.settings.contact_email != blank %}
            <a href="mailto:{{ section.settings.contact_email | escape }}">
              Contact Us
            </a>
          {% endif %}
        </div>

        <a
          class="om-apps-footer__store-link"
          href="{{ section.settings.all_apps_url | default: 'https://apps.shopify.com/partners/orangemantra' | escape }}"
          target="_blank"
          rel="noopener noreferrer"
        >
          <span class="om-apps-footer__store-icon" aria-hidden="true">
            <svg viewBox="0 0 40 40" fill="none">
              <path d="M9 13h22l3 23H6L9 13Z" fill="currentColor"/>
              <path d="M14 15V10a6 6 0 0 1 12 0v5" stroke="currentColor" stroke-width="3" fill="none"/>
              <path d="m15 23 4 4 7-8" stroke="white" stroke-width="2.5" fill="none"/>
            </svg>
          </span>
          <span>
            <small>Discover our apps on</small>
            <strong>Shopify App Store</strong>
          </span>
          <span aria-hidden="true">↗</span>
        </a>

      </div>
    </div>
  {% endif %}
</section>

<style>
  #om-apps-footer-{{ section.id }} {
    background: linear-gradient(357deg, rgb(255, 250, 233) 15%, rgba(255, 250, 233, 0.25) 100%);;
    color: var(--om-text);
    font-family: inherit;
    overflow: hidden;
  }

  #om-apps-footer-{{ section.id }} * {
    box-sizing: border-box;
  }

  #om-apps-footer-{{ section.id }} .om-apps-footer__inner {
    max-width: 1440px;
    margin: 0 auto;
    padding: 56px 48px 44px;
  }

  #om-apps-footer-{{ section.id }} .om-apps-footer__heading {
    text-align: center;
    margin: 0 auto 38px;
  }

  #om-apps-footer-{{ section.id }} .om-apps-footer__eyebrow {
    margin: 0 0 10px;
    color: var(--om-accent);
    font-size: 12px;
    font-weight: 750;
    letter-spacing: 3px;
    text-transform: uppercase;
  }

  #om-apps-footer-{{ section.id }} .om-apps-footer__heading h2 {
    margin: 0;
    color: var(--om-heading);
    font-size: clamp(27px, 3vw, 42px);
    line-height: 1.15;
    letter-spacing: -1.2px;
    font-weight: 750;
  }

  #om-apps-footer-{{ section.id }} .om-apps-footer__description {
    margin: 13px 0 0;
    font-size: 16px;
    line-height: 1.6;
    color: var(--om-text);
    opacity: .85;
  }

  #om-apps-footer-{{ section.id }} .om-apps-footer__carousel-wrap {
    position: relative;
  }

  #om-apps-footer-{{ section.id }} .om-apps-footer__track {
    display: grid;
    grid-auto-columns: calc((100% - 48px) / 4);
    grid-auto-flow: column;
    gap: 16px;
    overflow-x: auto;
    overscroll-behavior-inline: contain;
    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;
    scrollbar-width: none;
    padding: 4px 2px 12px;
  }

  #om-apps-footer-{{ section.id }} .om-apps-footer__track::-webkit-scrollbar {
    display: none;
  }

  #om-apps-footer-{{ section.id }} .om-apps-footer__card {
    min-width: 0;
    scroll-snap-align: start;
    background: var(--om-card-bg);
    border: 1px solid rgba(20, 35, 60, .07);
    border-radius: 15px;
    overflow: hidden;
    box-shadow: 0 5px 22px rgba(20, 35, 60, .035);
    transition: transform .2s ease, box-shadow .2s ease;
  }

  #om-apps-footer-{{ section.id }} .om-apps-footer__card:hover {
    transform: translateY(-3px);
    box-shadow: 0 12px 28px rgba(20, 35, 60, .08);
  }

  #om-apps-footer-{{ section.id }} .om-apps-footer__card-link {
    display: flex;
    height: 100%;
    min-height: 205px;
    flex-direction: column;
    align-items: flex-start;
    padding: 20px;
    color: inherit;
    text-decoration: none;
  }

  #om-apps-footer-{{ section.id }} .om-apps-footer__card-top {
    display: flex;
    width: 100%;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: 17px;
  }

  #om-apps-footer-{{ section.id }} .om-apps-footer__icon {
    width: 62px;
    height: 62px;
    flex: 0 0 62px;
    display: grid;
    place-items: center;
    border-radius: 14px;
    background: #f8f5f7;
    overflow: hidden;
  }

  #om-apps-footer-{{ section.id }} .om-apps-footer__icon img {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: contain;
    border-radius: inherit;
  }

  #om-apps-footer-{{ section.id }} .om-apps-footer__icon-placeholder {
    color: var(--om-accent);
    font-size: 26px;
    font-weight: 750;
  }

  #om-apps-footer-{{ section.id }} .om-apps-footer__card-arrow {
    display: grid;
    place-items: center;
    width: 34px;
    height: 34px;
    border: 1px solid rgba(20, 35, 60, .09);
    border-radius: 50%;
    font-size: 18px;
  }

  #om-apps-footer-{{ section.id }} .om-apps-footer__card h3 {
    margin: 0 0 8px;
    color: var(--om-heading);
    font-size: 17px;
    font-weight: 700;
    line-height: 1.35;
  }

  #om-apps-footer-{{ section.id }} .om-apps-footer__card p {
    margin: 0;
    font-size: 13px;
    line-height: 1.55;
    opacity: .8;
  }

  #om-apps-footer-{{ section.id }} .om-apps-footer__learn {
    display: flex;
    align-items: center;
    gap: 7px;
    margin-top: auto;
    padding-top: 16px;
    color: var(--om-accent);
    font-size: 13px;
    font-weight: 700;
  }

  #om-apps-footer-{{ section.id }} .om-apps-footer__arrow {
    position: absolute;
    z-index: 2;
    top: 50%;
    display: grid;
    place-items: center;
    width: 42px;
    height: 42px;
    padding: 0;
    border: 1px solid rgba(20, 35, 60, .08);
    border-radius: 50%;
    background: var(--om-card-bg);
    color: var(--om-heading);
    font-size: 29px;
    line-height: 1;
    cursor: pointer;
    box-shadow: 0 3px 15px rgba(20, 35, 60, .08);
    transform: translateY(-50%);
  }

  #om-apps-footer-{{ section.id }} .om-apps-footer__arrow--prev {
    left: -20px;
  }

  #om-apps-footer-{{ section.id }} .om-apps-footer__arrow--next {
    right: -20px;
  }

  #om-apps-footer-{{ section.id }} .om-apps-footer__arrow:disabled {
    opacity: .35;
    cursor: default;
  }

  #om-apps-footer-{{ section.id }} .om-apps-footer__cta {
    display: flex;
    justify-content: center;
    margin-top: 24px;
  }

  #om-apps-footer-{{ section.id }} .om-apps-footer__button {
    display: inline-flex;
    justify-content: center;
    align-items: center;
    gap: 14px;
    padding: 15px 25px;
    border-radius: 999px;
    background: var(--om-accent);
    color: #fff;
    text-decoration: none;
    font-size: 14px;
    font-weight: 700;
    transition: opacity .2s ease, transform .2s ease;
  }

  #om-apps-footer-{{ section.id }} .om-apps-footer__button:hover {
    opacity: .9;
    transform: translateY(-2px);
  }

  #om-apps-footer-{{ section.id }} .om-apps-footer__brand-strip {
    border-top: 1px solid rgba(20, 35, 60, .08);
    background: var(--om-card-bg);
  }

  #om-apps-footer-{{ section.id }} .om-apps-footer__brand-inner {
    max-width: 1440px;
    margin: 0 auto;
    padding: 32px 48px;
    display: grid;
    grid-template-columns: 1.5fr .8fr 1.2fr;
    gap: 48px;
    align-items: center;
  }

  #om-apps-footer-{{ section.id }} .om-apps-footer__brand > a:first-child {
    display: inline-block;
    text-decoration: none;
  }

  #om-apps-footer-{{ section.id }} .om-apps-footer__brand > a:first-child img {
    display: block;
    width: 220px;
    max-width: 100%;
    height: auto;
  }

  #om-apps-footer-{{ section.id }} .om-apps-footer__brand-name {
    color: var(--om-heading);
    font-size: 27px;
    font-weight: 750;
    letter-spacing: -1px;
  }

  #om-apps-footer-{{ section.id }} .om-apps-footer__brand-name span {
    color: #f04a26;
  }

  #om-apps-footer-{{ section.id }} .om-apps-footer__brand p {
    max-width: 380px;
    margin: 12px 0;
    font-size: 14px;
    line-height: 1.7;
    opacity: .8;
  }

  #om-apps-footer-{{ section.id }} .om-apps-footer__contact {
    color: var(--om-text);
    font-size: 13px;
    overflow-wrap: anywhere;
  }

  #om-apps-footer-{{ section.id }} .om-apps-footer__brand-links {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 12px;
  }

  #om-apps-footer-{{ section.id }} .om-apps-footer__brand-links h3 {
    margin: 0 0 4px;
    color: var(--om-heading);
    font-size: 16px;
  }

  #om-apps-footer-{{ section.id }} .om-apps-footer__brand-links a {
    color: var(--om-text);
    font-size: 14px;
    text-decoration: none;
    opacity: .8;
  }

  #om-apps-footer-{{ section.id }} .om-apps-footer__brand-links a:hover {
    color: var(--om-accent);
    opacity: 1;
  }

  #om-apps-footer-{{ section.id }} .om-apps-footer__store-link {
    display: flex;
    align-items: center;
    gap: 13px;
    min-width: 0;
    padding: 17px;
    border: 1px solid rgba(20, 35, 60, .12);
    border-radius: 12px;
    color: var(--om-heading);
    text-decoration: none;
    transition: border-color .2s ease;
  }

  #om-apps-footer-{{ section.id }} .om-apps-footer__store-link:hover {
    border-color: var(--om-accent);
  }

  #om-apps-footer-{{ section.id }} .om-apps-footer__store-icon {
    width: 40px;
    height: 40px;
    flex: 0 0 40px;
  }

  #om-apps-footer-{{ section.id }} .om-apps-footer__store-icon svg {
    display: block;
    width: 100%;
    height: 100%;
  }

  #om-apps-footer-{{ section.id }} .om-apps-footer__store-link small,
  #om-apps-footer-{{ section.id }} .om-apps-footer__store-link strong {
    display: block;
  }

  #om-apps-footer-{{ section.id }} .om-apps-footer__store-link small {
    margin-bottom: 4px;
    font-size: 12px;
    opacity: .75;
  }

  #om-apps-footer-{{ section.id }} .om-apps-footer__store-link strong {
    font-size: 15px;
  }

  #om-apps-footer-{{ section.id }} .om-apps-footer__store-link > span:last-child {
    margin-left: auto;
  }

  @media screen and (min-width: 1200px) {
    #om-apps-footer-{{ section.id }} .om-apps-footer__track {
      grid-auto-columns: calc((100% - 64px) / 5);
    }
  }

  @media screen and (max-width: 989px) {
    #om-apps-footer-{{ section.id }} .om-apps-footer__inner {
      padding: 42px 30px 34px;
    }

    #om-apps-footer-{{ section.id }} .om-apps-footer__track {
      grid-auto-columns: calc((100% - 16px) / 2);
    }

    #om-apps-footer-{{ section.id }} .om-apps-footer__brand-inner {
      padding: 28px 30px;
      grid-template-columns: 1fr 1fr;
      gap: 30px;
    }

    #om-apps-footer-{{ section.id }} .om-apps-footer__store-link {
      grid-column: 1 / -1;
    }

    #om-apps-footer-{{ section.id }} .om-apps-footer__arrow--prev {
      left: -15px;
    }

    #om-apps-footer-{{ section.id }} .om-apps-footer__arrow--next {
      right: -15px;
    }
  }

  @media screen and (max-width: 600px) {
    #om-apps-footer-{{ section.id }} .om-apps-footer__inner {
      padding: 34px 18px 30px;
    }

    #om-apps-footer-{{ section.id }} .om-apps-footer__heading {
      margin-bottom: 25px;
    }

    #om-apps-footer-{{ section.id }} .om-apps-footer__heading h2 {
      font-size: 27px;
      letter-spacing: -.7px;
    }

    #om-apps-footer-{{ section.id }} .om-apps-footer__description {
      font-size: 14px;
    }

    #om-apps-footer-{{ section.id }} .om-apps-footer__track {
      grid-auto-columns: 82%;
      gap: 12px;
      margin-right: -18px;
      padding-right: 18px;
    }

    #om-apps-footer-{{ section.id }} .om-apps-footer__card-link {
      min-height: 200px;
      padding: 17px;
    }

    #om-apps-footer-{{ section.id }} .om-apps-footer__arrow {
      display: none;
    }

    #om-apps-footer-{{ section.id }} .om-apps-footer__brand-inner {
      padding: 27px 20px;
      grid-template-columns: 1fr;
      gap: 25px;
    }

    #om-apps-footer-{{ section.id }} .om-apps-footer__store-link {
      grid-column: auto;
    }

    #om-apps-footer-{{ section.id }} .om-apps-footer__button {
      width: 100%;
      max-width: 320px;
      padding: 14px 18px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    #om-apps-footer-{{ section.id }} *,
    #om-apps-footer-{{ section.id }} *::before,
    #om-apps-footer-{{ section.id }} *::after {
      scroll-behavior: auto !important;
      transition: none !important;
    }
  }
</style>

<script>
  (() => {
    const root = document.getElementById('om-apps-footer-{{ section.id }}');
    if (!root || root.dataset.omInitialized === 'true') return;

    root.dataset.omInitialized = 'true';

    const track = root.querySelector('[data-om-track]');
    const prev = root.querySelector('[data-om-prev]');
    const next = root.querySelector('[data-om-next]');

    if (!track) return;

    const updateArrows = () => {
      const maxScroll = track.scrollWidth - track.clientWidth;

      if (prev) {
        prev.disabled = track.scrollLeft <= 2;
      }

      if (next) {
        next.disabled = track.scrollLeft >= maxScroll - 2;
      }
    };

    const scrollTrack = (direction) => {
      const card = track.querySelector('.om-apps-footer__card');
      if (!card) return;

      const gap = parseFloat(getComputedStyle(track).columnGap) || 0;
      const distance = card.getBoundingClientRect().width + gap;

      track.scrollBy({
        left: direction * distance,
        behavior: 'smooth'
      });
    };

    prev?.addEventListener('click', () => scrollTrack(-1));
    next?.addEventListener('click', () => scrollTrack(1));

    track.addEventListener('scroll', updateArrows, { passive: true });
    window.addEventListener('resize', updateArrows);

    updateArrows();

    if ('ResizeObserver' in window) {
      const observer = new ResizeObserver(updateArrows);
      observer.observe(track);
    }

    document.addEventListener('shopify:section:load', (event) => {
      if (event.detail?.sectionId === '{{ section.id }}') {
        root.dataset.omInitialized = 'false';
      }
    });
  })();
</script>

{% schema %}
{
  "name": "OM Apps Footer",
  "tag": "section",
  "class": "om-apps-footer-section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Small heading",
      "default": "OUR SHOPIFY APPS"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Main heading",
      "default": "More Apps to Grow Your Store"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Powerful Shopify apps built to help you sell more and work smarter."
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent color",
      "default": "#F53670"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "default": "#10233F"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#606674"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Section background",
      "default": "#FFFAFC"
    },
    {
      "type": "color",
      "id": "card_color",
      "label": "Card and brand-strip background",
      "default": "#FFFFFF"
    },
    {
      "type": "checkbox",
      "id": "show_arrows",
      "label": "Show carousel arrows",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_all_button",
      "label": "Show all apps button",
      "default": true
    },
    {
      "type": "text",
      "id": "all_apps_label",
      "label": "All apps button label",
      "default": "View All Shopify Apps"
    },
    {
      "type": "url",
      "id": "all_apps_url",
      "label": "All apps page URL"
    },
    {
      "type": "checkbox",
      "id": "show_brand_strip",
      "label": "Show OrangeMantra brand strip",
      "default": true
    },
    {
      "type": "image_picker",
      "id": "brand_logo",
      "label": "OrangeMantra logo"
    },
    {
      "type": "url",
      "id": "brand_url",
      "label": "Brand website URL"
    },
    {
      "type": "textarea",
      "id": "brand_description",
      "label": "Brand description",
      "default": "We build powerful Shopify apps and themes to help merchants grow their business."
    },
    {
      "type": "text",
      "id": "contact_email",
      "label": "Contact email",
      "default": "appsupport@orangemantra.in"
    }
  ],
  "blocks": [
    {
      "type": "app",
